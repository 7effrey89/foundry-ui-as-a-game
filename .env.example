# Azure AI Foundry
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1
FOUNDRY_API_VERSION=

# Azure Speech Service (MAI-Voice-1 TTS) — all optional
# AZURE_SPEECH_KEY=<xxxxx ; undefined will use DefaultAzureCredential instead>.
AZURE_SPEECH_REGION=swedencentral
# AZURE_SPEECH_TTS_ENDPOINT=
# ARM resource ID — enables aad#resource_id#token auth format.
# Find this in Azure Portal → your resource → Properties → Resource ID.
AZURE_SPEECH_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<name>

# Only needed if DefaultAzureCredential can't resolve your tenant automatically.
# AZURE_TENANT_ID=<your-tenant-id>